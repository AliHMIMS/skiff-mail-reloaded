# mymail-server configuration. Copy to .env (chmod 600).

LISTEN=127.0.0.1:4201
PUBLIC_URL=https://mail.example.com
DATA_DIR=./data

# Gmail / Google Workspace account
GMAIL_ADDRESS=you@example.com
# App password (https://myaccount.google.com/apppasswords). Optional once Google OAuth is connected.
GMAIL_APP_PASSWORD=

# Days of mail to sync. Older mail stays in Gmail.
SYNC_DAYS=90
DISPLAY_NAME=

# Google OAuth client (Gmail API: filters, vacation responder, XOAUTH2).
# Redirect URI: https://mail.example.com/graphql/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail push via Cloud Pub/Sub. Topic: projects/<project-id>/topics/<topic>
# Push endpoint: https://mail.example.com/graphql/gmail/push?token=<GMAIL_PUSH_TOKEN>
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_TOKEN=
